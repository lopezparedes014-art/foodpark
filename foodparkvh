            "Mexicana": { "8_sin": 65000, "8_con": 70000, "12_sin": 80000, "12_con": 90000 },
            "Jamón y Queso": { "8_sin": 50000, "8_con": 65000, "12_sin": 70000, "12_con": 80000 },
            "Catupollo": { "8_sin": 65000, "8_con": 70000, "12_sin": 75000, "12_con": 85000 },
            "Napolitana": { "8_sin": 55000, "8_con": 65000, "12_sin": 75000, "12_con": 85000 },
            "Catupiri": { "8_sin": 60000, "8_con": 65000, "12_sin": 75000, "12_con": 85000 },
            "Panceta y Cheddar": { "8_sin": 65000, "8_con": 70000, "12_sin": 80000, "12_con": 90000 },
            "Palmitos": { "8_sin": 60000, "8_con": 65000, "12_sin": 75000, "12_con": 85000 },
            "Katucarne": { "8_sin": 65000, "8_con": 70000, "12_sin": 75000, "12_con": 90000 },
            "Carnívora": { "8_sin": 65000, "8_con": 70000, "12_sin": 80000, "12_con": 90000 },
            "Vegetariana": { "8_sin": 60000, "8_con": 65000, "12_sin": 75000, "12_con": 85000 },
            "Champignones a la Crema": { "8_sin": 60000, "8_con": 65000, "12_sin": 75000, "12_con": 85000 },
            "Cuatro Quesos": { "8_sin": 60000, "8_con": 65000, "12_sin": 75000, "12_con": 85000 }
        };

        function initPizzaFlavorSelectors() {
            const f1 = document.getElementById('flavor-1');
            const f2 = document.getElementById('flavor-2');
            const names = Object.keys(pizzaFlavors);

            names.forEach(name => {
                const opt1 = document.createElement('option');
                opt1.value = name;
                opt1.textContent = name;
                f1.appendChild(opt1);

                const opt2 = document.createElement('option');
                opt2.value = name;
                opt2.textContent = name;
                f2.appendChild(opt2);
            });

            updateHalfPizzaPrice();
        }

        function getHalfPizzaVariantKey() {
            const size = document.getElementById('half-size').value;
            const crust = document.getElementById('half-crust').value;
            return `${size}_${crust}`;
        }

        function calculateHalfPizzaPrice() {
            const f1 = document.getElementById('flavor-1').value;
            const f2 = document.getElementById('flavor-2').value;
            const key = getHalfPizzaVariantKey();

            const p1 = f1 ? pizzaFlavors[f1][key] : 0;
            const p2 = f2 ? pizzaFlavors[f2][key] : 0;

            if (f1 && f2) return Math.max(p1, p2);
            if (f1) return p1;
            if (f2) return p2;
            return pizzaFlavors["Muzzarella"][key];
        }

        function updateHalfPizzaPrice() {
            const f1 = document.getElementById('flavor-1').value;
            const f2 = document.getElementById('flavor-2').value;
            const size = document.getElementById('half-size').value;
            const crustLabel = document.getElementById('half-crust').value === 'con' ? 'Con Borde' : 'Sin Borde';
            const price = calculateHalfPizzaPrice();

            document.getElementById('half-pizza-price').textContent = price.toLocaleString() + " GS.";

            const summaryEl = document.getElementById('half-pizza-summary');
            if (!f1 && !f2) {
                summaryEl.textContent = `Base: ${size} Porciones · ${crustLabel}. Elige 2 sabores.`;
            } else if (f1 && !f2) {
                summaryEl.textContent = `Sabor 1: ${f1} · Falta Sabor 2 (${size} P. ${crustLabel}).`;
            } else if (!f1 && f2) {
                summaryEl.textContent = `Falta Sabor 1 · Sabor 2: ${f2} (${size} P. ${crustLabel}).`;
            } else {
                summaryEl.textContent = `½ ${f1} + ½ ${f2} (${size} P. ${crustLabel})`;
            }
        }

        function addHalfPizzaToCart() {
            const f1 = document.getElementById('flavor-1').value;
            const f2 = document.getElementById('flavor-2').value;
            const size = document.getElementById('half-size').value;
            const crustLabel = document.getElementById('half-crust').value === 'con' ? 'Con Borde' : 'Sin Borde';

            if (!f1 || !f2) {
                alert("Por favor selecciona los 2 sabores para tu pizza de 2 sabores.");
                return;
            }

            const price = calculateHalfPizzaPrice();
            const itemName = `Pizza 2 Sabores: ½ ${f1} + ½ ${f2} (${size} P. ${crustLabel})`;
            addToCart(itemName, price);
        }

        function addToCart(name, price) {
            const existing = cart.find(item => item.name === name);
            if (existing) {
                existing.qty += 1;
            } else {
                cart.push({ name, price, qty: 1 });
            }
            updateCartUI();
        }

        function changeQty(index, delta) {
            cart[index].qty += delta;
            if (cart[index].qty <= 0) {
                cart.splice(index, 1);
            }
            updateCartUI();
        }

        function updateCartUI() {
            const cartContainer = document.getElementById('cart-items');
            const cartCount = document.getElementById('cart-count');
            const cartTotal = document.getElementById('cart-total');

            let totalCount = cart.reduce((sum, item) => sum + item.qty, 0);
            let totalPrice = cart.reduce((sum, item) => sum + (item.price * item.qty), 0);

            cartCount.textContent = totalCount;
            cartTotal.textContent = totalPrice.toLocaleString() + " GS.";

            if (cart.length === 0) {
                cartContainer.innerHTML = `<p class="text-xs text-gray-500 text-center py-8">Tu carrito está vacío.<br>Selecciona tus platos favoritos.</p>`;
                return;
            }

            cartContainer.innerHTML = '';
            cart.forEach((item, index) => {
                const el = document.createElement('div');
                el.className = "py-2.5 flex justify-between items-center text-xs";
                el.innerHTML = `
                    <div class="flex-1 pr-2">
                        <p class="font-semibold text-gray-200">${item.name}</p>
                        <p class="text-emerald-400 font-medium">${(item.price * item.qty).toLocaleString()} GS.</p>
                    </div>
                    <div class="flex items-center gap-2 bg-[#0B0D0C] border border-emerald-900/50 rounded-lg p-1">
                        <button onclick="changeQty(${index}, -1)" class="w-5 h-5 flex items-center justify-center text-gray-400 hover:text-white cursor-pointer">-</button>
                        <span class="font-bold text-white px-1">${item.qty}</span>
                        <button onclick="changeQty(${index}, 1)" class="w-5 h-5 flex items-center justify-center text-gray-400 hover:text-white cursor-pointer">+</button>
                    </div>
                `;
                cartContainer.appendChild(el);
            });
        }

        function filterMenu() {
            const term = document.getElementById('searchInput').value.toLowerCase();
            const sections = document.querySelectorAll('.menu-section');

            sections.forEach(section => {
                const items = section.querySelectorAll('.food-item');
                let sectionHasMatch = false;

                items.forEach(item => {
                    const text = item.textContent.toLowerCase();
                    if (text.includes(term)) {
                        item.style.display = "";
                        sectionHasMatch = true;
                    } else {
                        item.style.display = "none";
                    }
                });

                section.style.display = (sectionHasMatch || term === "") ? "block" : "none";
            });
        }

        function sendWhatsAppOrder() {
            if (cart.length === 0) {
                alert("Por favor selecciona al menos un plato o bebida antes de enviar tu pedido.");
                return;
            }

            const name = document.getElementById('client-name').value.trim();
            const table = document.getElementById('client-table').value.trim();

            if (!name) {
                alert("Por favor ingresa tu nombre y apellido.");
                document.getElementById('client-name').focus();
                return;
            }

            let message = `*¡Nuevo Pedido - Villa Hayes Food Park!* 🍔\n\n`;
            message += `👤 *Cliente:* ${name}\n`;
            message += `📍 *Mesa / Ubicación:* ${table || 'No especificada'}\n\n`;
            message += `--------------------------------\n`;
            
            cart.forEach(item => {
                message += `• ${item.qty}x ${item.name} - *${(item.price * item.qty).toLocaleString()} GS.*\n`;
            });

            let totalPrice = cart.reduce((sum, item) => sum + (item.price * item.qty), 0);
            message += `--------------------------------\n`;
            message += `💰 *TOTAL A PAGAR: ${totalPrice.toLocaleString()} GS.*`;

            const phoneNumber = "595987585014"; 
            const url = `https://wa.me/${phoneNumber}?text=${encodeURIComponent(message)}`;
            window.open(url, '_blank');
        }

        initPizzaFlavorSelectors();
    </script>
