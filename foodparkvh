                        </div>
                    </div>

                    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-2.5 pt-3 border-t border-emerald-900/30 text-xs">
                        <div>
                            <label for="flavor-1" class="block text-[11px] text-emerald-300/90 font-semibold mb-1">Sabor 1</label>
                            <select id="flavor-1" onchange="updateHalfPizzaPrice()" class="w-full bg-[#141816] text-gray-200 px-2.5 py-2 rounded-lg border border-emerald-900/60 focus:outline-none focus:border-emerald-500 cursor-pointer">
                                <option value="">-- Sabor 1 --</option>
                            </select>
                        </div>

                        <div>
                            <label for="flavor-2" class="block text-[11px] text-emerald-300/90 font-semibold mb-1">Sabor 2</label>
                            <select id="flavor-2" onchange="updateHalfPizzaPrice()" class="w-full bg-[#141816] text-gray-200 px-2.5 py-2 rounded-lg border border-emerald-900/60 focus:outline-none focus:border-emerald-500 cursor-pointer">
                                <option value="">-- Sabor 2 --</option>
                            </select>
                        </div>

                        <div>
                            <label for="half-size" class="block text-[11px] text-gray-300 font-semibold mb-1">Porciones</label>
