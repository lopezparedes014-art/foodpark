                    </div>
                    <div class="food-item bg-[#0B0D0C] border border-emerald-900/30 rounded-xl p-4 flex flex-col justify-between">
                        <div><h4 class="font-bold text-gray-100 text-sm">Especial</h4><p class="text-xs text-gray-400 mt-1">Pan, carne, lechuga, tomate, jamón y queso, cheddar, cebolla, panceta, huevo.</p></div>
                        <div class="mt-4 pt-3 border-t border-emerald-900/20 flex flex-col gap-1 text-xs">
                            <button onclick="addToCart('Hamburguesa Especial (Sin Combo)', 24000)" class="bg-[#141816] hover:bg-emerald-500 hover:text-black text-gray-300 px-2 py-1.5 rounded-lg border border-emerald-900/50 flex justify-between cursor-pointer"><span>Sin Combo:</span> <strong class="text-emerald-400">24.000 GS.</strong></button>
                            <button onclick="addToCart('Hamburguesa Especial (Con Combo)', 30000)" class="bg-[#141816] hover:bg-emerald-500 hover:text-black text-gray-300 px-2 py-1.5 rounded-lg border border-emerald-900/50 flex justify-between cursor-pointer"><span>Con Combo:</span> <strong class="text-emerald-400">30.000 GS.</strong></button>
                        </div>
                    </div>
                    <div class="food-item bg-[#0B0D0C] border border-emerald-900/30 rounded-xl p-4 flex flex-col justify-between">
                        <div><h4 class="font-bold text-gray-100 text-sm">Especial Doble Carne</h4><p class="text-xs text-gray-400 mt-1">Pan, doble carne, lechuga, tomate, jamón y queso, cheddar, cebolla, panceta, huevo.</p></div>
                        <div class="mt-4 pt-3 border-t border-emerald-900/20 flex flex-col gap-1 text-xs">
                            <button onclick="addToCart('Hamburguesa Doble Carne (Sin Combo)', 28000)" class="bg-[#141816] hover:bg-emerald-500 hover:text-black text-gray-300 px-2 py-1.5 rounded-lg border border-emerald-900/50 flex justify-between cursor-pointer"><span>Sin Combo:</span> <strong class="text-emerald-400">28.000 GS.</strong></button>
                            <button onclick="addToCart('Hamburguesa Doble Carne (Con Combo)', 35000)" class="bg-[#141816] hover:bg-emerald-500 hover:text-black text-gray-300 px-2 py-1.5 rounded-lg border border-emerald-900/50 flex justify-between cursor-pointer"><span>Con Combo:</span> <strong class="text-emerald-400">35.000 GS.</strong></button>
                        </div>
                    </div>
                    <div class="food-item bg-[#0B0D0C] border border-emerald-900/30 rounded-xl p-4 flex flex-col justify-between">
                        <div><h4 class="font-bold text-gray-100 text-sm">Especial Triple Carne</h4><p class="text-xs text-gray-400 mt-1">Pan, triple carne, lechuga, tomate, jamón y queso, cheddar, cebolla, panceta, huevo.</p></div>
                        <div class="mt-4 pt-3 border-t border-emerald-900/20 flex flex-col gap-1 text-xs">
                            <button onclick="addToCart('Hamburguesa Triple Carne (Sin Combo)', 35000)" class="bg-[#141816] hover:bg-emerald-500 hover:text-black text-gray-300 px-2 py-1.5 rounded-lg border border-emerald-900/50 flex justify-between cursor-pointer"><span>Sin Combo:</span> <strong class="text-emerald-400">35.000 GS.</strong></button>
                            <button onclick="addToCart('Hamburguesa Triple Carne (Con Combo)', 42000)" class="bg-[#141816] hover:bg-emerald-500 hover:text-black text-gray-300 px-2 py-1.5 rounded-lg border border-emerald-900/50 flex justify-between cursor-pointer"><span>Con Combo:</span> <strong class="text-emerald-400">42.000 GS.</strong></button>
                        </div>
                    </div>
                    <div class="food-item bg-[#0B0D0C] border border-emerald-900/30 rounded-xl p-4 flex flex-col justify-between">
                        <div><h4 class="font-bold text-gray-100 text-sm">Kids</h4><p class="text-xs text-gray-400 mt-1">Pan, carne, queso.</p></div>
                        <div class="mt-4 pt-3 border-t border-emerald-900/20 flex flex-col gap-1 text-xs">
                            <button onclick="addToCart('Hamburguesa Kids (Sin Combo)', 14000)" class="bg-[#141816] hover:bg-emerald-500 hover:text-black text-gray-300 px-2 py-1.5 rounded-lg border border-emerald-900/50 flex justify-between cursor-pointer"><span>Sin Combo:</span> <strong class="text-emerald-400">14.000 GS.</strong></button>
                            <button onclick="addToCart('Hamburguesa Kids (Con Combo)', 20000)" class="bg-[#141816] hover:bg-emerald-500 hover:text-black text-gray-300 px-2 py-1.5 rounded-lg border border-emerald-900/50 flex justify-between cursor-pointer"><span>Con Combo:</span> <strong class="text-emerald-400">20.000 GS.</strong></button>
                        </div>
                    </div>
                </div>
            </div>

            <!-- 4. CHIVITO Y LOMIPIZZA -->
            <div class="menu-section bg-[#141816]/60 border border-emerald-900/40 rounded-2xl p-6 shadow-xl">
                <div class="mb-6 pb-3 border-b border-emerald-900/40">
                    <h2 class="text-xl font-bold text-white tracking-wide flex items-center gap-2"><span class="w-2.5 h-2.5 rounded-full bg-emerald-500"></span> Chivito & Lomipizza</h2>
                    <p class="text-xs text-gray-400 mt-1">Especialidades de la casa</p>
                </div>
                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    <div class="food-item bg-[#0B0D0C] border border-emerald-900/30 rounded-xl p-4 flex flex-col justify-between">
                        <div><h4 class="font-bold text-gray-100 text-sm">Chivito Tradicional</h4><p class="text-xs text-gray-400 mt-1">Pan, carne, lechuga, tomate, jamón, queso, huevo.</p></div>
