                            <button onclick="addToCart('Hamburguesa Clásica (Sin Combo)', 16000)" class="bg-[#141816] hover:bg-emerald-500 hover:text-black text-gray-300 px-2 py-1.5 rounded-lg border border-emerald-900/50 flex justify-between cursor-pointer"><span>Sin Combo:</span> <strong class="text-emerald-400">16.000 GS.</strong></button>
                            <button onclick="addToCart('Hamburguesa Clásica (Con Combo)', 22000)" class="bg-[#141816] hover:bg-emerald-500 hover:text-black text-gray-300 px-2 py-1.5 rounded-lg border border-emerald-900/50 flex justify-between cursor-pointer"><span>Con Combo:</span> <strong class="text-emerald-400">22.000 GS.</strong></button>
