                        <div class="mt-4 pt-3 border-t border-emerald-900/20 flex items-center justify-between"><span class="font-bold text-emerald-400 text-sm">30.000 GS.</span><button onclick="addToCart('Lomito Especial', 30000)" class="bg-emerald-500/10 hover:bg-emerald-500 hover:text-black text-emerald-400 border border-emerald-500/30 text-xs font-semibold px-3 py-1.5 rounded-lg transition-all cursor-pointer">+ Agregar</button></div>
